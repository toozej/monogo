# Directory metadata is architecture-independent; keep this RUN on the native
# builder so multi-platform image assembly does not require QEMU/binfmt.
FROM --platform=$BUILDPLATFORM golang:1.27.4-trixie AS filesystem
RUN mkdir -p /container-root/home/nonroot && \
    chown -R 65532:65532 /container-root
# runtime image including CA certs and tzdata
FROM debian:trixie-slim
# Install or update runtime packages from the base distribution repositories.
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates python3 python3-pip python3-venv && \
    rm -rf /var/lib/apt/lists/*
# Install Python tools in a virtual environment to preserve system packages.
ENV PATH="/opt/venv/bin:${PATH}"
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/python -m pip install --no-cache-dir sncli==0.4.4
ENV HOME="/home/nonroot"
# Copy our static executable.
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/notes-courier /go/bin/notes-courier
# Include the project license in the runtime image.
COPY LICENSE /usr/share/doc/notes-courier/copyright
COPY --from=filesystem --chown=65532:65532 /container-root/home/nonroot /home/nonroot
WORKDIR /home/nonroot
# Expose port for publishing as web service
# EXPOSE 8081
# Verify that the application binary can start without requiring a shell or
# additional utilities in the minimal runtime image.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["/go/bin/notes-courier", "version"]
# Run the binary.
USER 65532:65532
ENTRYPOINT ["/go/bin/notes-courier"]
