# The Docker demo uses Google Translate by default, so it can run without a
# local TTS service. Change TTS_BACKEND to openai to use the Speaches sidecar
# from docker-compose.yml instead.
TTS_BACKEND=google
GOOGLE_TRANSLATE_LANG=en
TTS_FORMAT=mp3
OUTPUT_DIR=/out

# OpenAI-compatible backend settings (used when TTS_BACKEND=openai).
OPENAI_BASE_URL=http://speaches:8000/v1
OPENAI_API_KEY=cant-be-empty
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=af_heart
TTS_SPEED=1.0
TTS_TIMEOUT=5m
FETCH_TIMEOUT=30s
