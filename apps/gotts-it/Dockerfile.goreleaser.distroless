# Directory metadata is architecture-independent; keep this RUN on the native
# builder so multi-platform image assembly does not require QEMU/binfmt.
FROM --platform=$BUILDPLATFORM golang:1.26-trixie AS filesystem
RUN mkdir -p /container-root/out && \
    chown -R 65532:65532 /container-root
# runtime image including CA certs and tzdata
FROM gcr.io/distroless/static-debian13:nonroot
# Copy our static executable.
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/gotts-it /go/bin/gotts-it
# Include the project license in the runtime image.
COPY LICENSE /usr/share/doc/gotts-it/copyright
COPY --from=filesystem --chown=65532:65532 /container-root/out /out
WORKDIR /out
# Expose port for publishing as web service
# EXPOSE 8081
# Verify that the application binary can start without requiring a shell or
# additional utilities in the minimal runtime image.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["/go/bin/gotts-it", "version"]
# Run the binary.
ENTRYPOINT ["/go/bin/gotts-it"]
