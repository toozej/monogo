# runtime image including CA certs and tzdata
FROM gcr.io/distroless/static-debian13:nonroot
# Copy our static executable.
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/go-find-liquor /go/bin/go-find-liquor
# Include the project license in the runtime image.
COPY LICENSE /usr/share/doc/go-find-liquor/copyright
# Expose port for publishing as web service
# EXPOSE 8081
# Verify that the application binary can start without requiring a shell or
# additional utilities in the minimal runtime image.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["/go/bin/go-find-liquor", "version"]
# Run the binary.
ENTRYPOINT ["/go/bin/go-find-liquor"]
