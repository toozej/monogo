# Copy this file to ~/.config/notes2ssg-obsidian/.env.
# Set absolute paths for this machine. Keep credentials outside the vault.
BACKEND=simplenote
SSG_TYPE=obsidian
SN_USERNAME=you@example.com
SN_PASSWORD='replace-with-your-Simplenote-password'
SN_CLI_PATH=/home/you/.local/bin/sncli
OUTPUT_DIR="/home/you/Documents/MyVault/Simplenote"
POLLING_CYCLE=300
TAG_TO_DOWNLOAD=
OBSIDIAN_DELETE_MISSING=false
