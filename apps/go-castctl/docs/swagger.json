{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Local API for discovering playback devices, casting a video, and resolving a browser-playable stream. The server binds to loopback by default.",
        "title": "go-castctl API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/devices": {
            "get": {
                "description": "Returns the devices available to the local Castor service.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "Discover playback devices",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.devicesResponse"
                        }
                    },
                    "405": {
                        "description": "Method Not Allowed",
                        "schema": {
                            "$ref": "#/definitions/server.apiResponse"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/server.apiResponse"
                        }
                    }
                }
            }
        },
        "/receive": {
            "post": {
                "description": "Resolves the best browser-playable stream from a video page URL. The /view and /watch routes are aliases.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "playback"
                ],
                "summary": "Resolve a browser-playable stream",
                "parameters": [
                    {
                        "description": "Video page URL",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.request"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.apiResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.apiResponse"
                        }
                    },
                    "405": {
                        "description": "Method Not Allowed",
                        "schema": {
                            "$ref": "#/definitions/server.apiResponse"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/server.apiResponse"
                        }
                    },
                    "504": {
                        "description": "Gateway Timeout",
                        "schema": {
                            "$ref": "#/definitions/server.apiResponse"
                        }
                    }
                }
            }
        },
        "/send": {
            "post": {
                "description": "Starts a Castor session for the selected device. The /cast route is an alias.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "playback"
                ],
                "summary": "Cast a video to a device",
                "parameters": [
                    {
                        "description": "Video URL and playback device",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.request"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/server.apiResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/server.apiResponse"
                        }
                    },
                    "405": {
                        "description": "Method Not Allowed",
                        "schema": {
                            "$ref": "#/definitions/server.apiResponse"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/server.apiResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "castor.Device": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "server.apiResponse": {
            "type": "object",
            "properties": {
                "bitrate": {
                    "type": "integer"
                },
                "message": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "streamURL": {
                    "type": "string"
                }
            }
        },
        "server.devicesResponse": {
            "type": "object",
            "properties": {
                "devices": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/castor.Device"
                    }
                }
            }
        },
        "server.request": {
            "type": "object",
            "properties": {
                "device": {
                    "$ref": "#/definitions/castor.Device"
                },
                "url": {
                    "type": "string"
                }
            }
        }
    }
}