# Control plane settings. Replace placeholders before starting the service.
GOCICLE_DATABASE_URL=postgres://gocicle:REPLACE_ME@127.0.0.1:5432/gocicle?sslmode=require
GOCICLE_KEY_FILE=/etc/gocicle/keys.json
GOCICLE_LISTEN=127.0.0.1:8080
GOCICLE_PUBLIC_URL=https://gocicle.example.com
GOCICLE_TRUSTED_PROXIES=127.0.0.1/32,::1/128
GOCICLE_NOTIFICATION_HOSTS=notify.example.com
GOCICLE_RETENTION=720h

# Runner and API client settings. Enroll each runner before starting its service.
GOCICLE_API_URL=https://gocicle.example.com
GOCICLE_RUNTIME=docker
GOCICLE_SOCKET=/var/run/docker.sock
GOCICLE_STATE_DIR=/var/lib/gocicle-runner
# GOCICLE_TOKEN=REPLACE_ME
